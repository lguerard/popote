# Base de données
POSTGRES_PASSWORD=popote

# LLM local (Ollama)
OLLAMA_MODEL=qwen2.5:14b

# LLM cloud (optionnel — si défini, Claude est utilisé à la place d'Ollama)
CLAUDE_API_KEY=

# Whisper (transcription vidéo)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda   # cuda | cpu

# App
# Signe les jetons de session. Le backend REFUSE de demarrer si elle est
# absente, trop courte (32 caracteres minimum) ou laissee par defaut :
# une cle devinable laisse fabriquer un jeton valide pour n'importe quel
# compte. Generation :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Autorise les DEMANDES de compte. Aucune demande n'est accordee sans
# validation d'un administrateur depuis la page Comptes : true ouvre le
# formulaire, pas l'acces.
#
# Le tout premier compte fait exception -- il n'y a alors personne pour
# valider : il est approuve d'office, devient administrateur, et adopte
# les recettes existantes. Mets donc true, cree TON compte, et laisse
# ensuite true si tu attends d'autres demandes.
ALLOW_SIGNUP=false
PORT=80

# Surveillance mensuelle des modèles (scripts/model_watch/, voir son README)
# — optionnel : sans ces variables, le rapport est seulement enregistré sur
# disque dans scripts/model_watch/reports/, pas envoyé par email.
MODEL_WATCH_SMTP_HOST=
MODEL_WATCH_SMTP_PORT=587
MODEL_WATCH_SMTP_USER=
MODEL_WATCH_SMTP_PASSWORD=
MODEL_WATCH_SMTP_FROM=
MODEL_WATCH_SMTP_TO=
MODEL_WATCH_SMTP_USE_TLS=true
# Marge de sécurité (Go) retranchée à la VRAM totale mesurée pour obtenir
# le budget des modèles candidats.
MODEL_WATCH_VRAM_HEADROOM_GB=1.0
# Nombre de modèles candidats testés par run (chacun peut peser plusieurs
# Go à télécharger — garder ce nombre bas si la bande passante est limitée).
MODEL_WATCH_MAX_CANDIDATES=3
# Écart de score minimal (sur 100) pour qu'un candidat soit jugé "vraiment
# meilleur" et remplace le modèle actuel, plutôt qu'un bruit de mesure.
MODEL_WATCH_MIN_IMPROVEMENT=5.0
