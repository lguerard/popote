# Base de données
POSTGRES_PASSWORD=popote

# LLM local (Ollama)
OLLAMA_MODEL=qwen2.5:14b

# LLM cloud (optionnel — si défini, Claude est utilisé à la place d'Ollama)
CLAUDE_API_KEY=

# Whisper (transcription vidéo)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda   # cuda | cpu

# App
SECRET_KEY=changeme-en-production
PORT=80

# Comptes — URL publique réelle de l'app. Sert à construire les liens de
# réinitialisation de mot de passe : derrière un tunnel Cloudflare, l'URL vue
# par le backend n'est pas celle que la personne ouvrira.
PUBLIC_URL=https://popote.exemple.fr
# Cookie de session en Secure. Laisser à true en HTTPS ; passer à false pour un
# accès en http:// sur le réseau local, sinon la connexion ne « prend » pas.
COOKIE_SECURE=true
